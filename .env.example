# ── Server ──
PORT=8080
# "*" allows all origins, or a comma-separated list like http://localhost:3000,https://licence.webxterm.me
CORS_ORIGINS=*
PORTAL_NAME=WebXTerm Licensing Portal

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017
MONGO_DB=license_portal

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# Bootstrap superadmin (created on first boot)
ADMIN_EMAIL=admin@webxterm.me
ADMIN_PASSWORD=change-me-strong-password

# ── License signing (optional) ──
# Leave empty to auto-generate an Ed25519 keypair on first boot (persisted in
# Mongo; public key printed in logs). Or provide base64 raw keys:
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# ── SMTP fallback (portal Settings → SMTP overrides these) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=licensing@webxterm.me

# ── Trial defaults (Community plan) ──
TRIAL_DAYS=30
TRIAL_MACHINE_QUOTA=10

# Hours a deployment may run on a cached signed license when the portal is unreachable
OFFLINE_GRACE_HOURS=72
